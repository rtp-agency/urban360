# In .env.local kopieren und ausfüllen. .env.local gehört nicht ins Repository.

# Endpunkt, der eine Formularanfrage entgegennimmt und als E-Mail zustellt.
# Erwartet JSON: { name, company, email, phone, subject, message, locale }
# Ohne diese Variable meldet das Formular einen Fehler, statt eine
# Zustellung vorzutäuschen.
CONTACT_WEBHOOK_URL=
