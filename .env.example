# In .env.local kopieren und ausfüllen. .env.local gehört nicht ins Repository.

# ---------------------------------------------------------------------------
# Datenbank
# ---------------------------------------------------------------------------
# Supabase, Region eu-central-1 (Frankfurt). Personenbezogene Daten von
# Bewerbern dürfen die EU nicht ohne Weiteres verlassen, die Region ist
# deshalb keine Geschmacksfrage.
#
# Aus dem Supabase-Dashboard: Project Settings -> Database -> Connection string
# -> "Transaction pooler" verwenden, nicht die direkte Verbindung.
DATABASE_URL=postgresql://postgres.PROJEKT:PASSWORT@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------------
# Meldung über neue Bewerbungen
# ---------------------------------------------------------------------------
# Der Bot verschickt ausschließlich Kennung, Ort, Tätigkeitsbereiche und einen
# Link in die Verwaltung. Keine Namen, keine Telefonnummern, kein
# Aufenthaltsstatus: Telegram sitzt außerhalb der EU, ein Chatverlauf hat
# keine Zugriffskontrolle und keine Löschfrist.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Aufräumlauf
# ---------------------------------------------------------------------------
# Schützt /api/cron/purge. Beliebige lange Zufallszeichenfolge.
# Erzeugen mit: openssl rand -base64 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# Zustellung des Kontaktformulars
# ---------------------------------------------------------------------------
# Ohne einen der beiden Wege meldet das Formular einen Fehler, statt eine
# Zustellung vorzutäuschen. Das ist Absicht.
#
# WEG 1, BEVORZUGT: SMTP über das Postfach der eigenen Domain.
# Kein zusätzlicher Auftragsverarbeiter, weil der Mailanbieter die Post
# dieser Domain ohnehin schon verarbeitet. Die Datenschutzerklärung bleibt
# damit unverändert richtig.
#
# Port 465 spricht sofort TLS, 587 handelt STARTTLS nach. Beides ist
# verschlüsselt, die Angabe muss nur zum Port passen.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=info@example.tld
SMTP_PASS=
# Absender. Leer lassen heisst: dieselbe Adresse wie SMTP_USER. Niemals die
# Adresse der anfragenden Person eintragen, sonst verschickt der Server Post
# im fremden Namen und scheitert an SPF und DMARC der fremden Domain.
SMTP_FROM=
# Empfänger. Leer lassen heisst: die Adresse aus site.config.ts.
CONTACT_TO=

# WEG 2: HTTP-Endpunkt wie Web3Forms oder Formspree.
# Schneller eingerichtet, aber ein weiterer Dritter sieht Name, Adresse und
# Nachricht der Anfragenden. Dafür braucht es einen AV-Vertrag und einen
# ergänzten Abschnitt über Empfänger in der Datenschutzerklärung.
# Wird nur ausgewertet, solange SMTP_HOST leer ist.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_KEY=
